        "all_of": [
          {
            "kind": "route",
            "frame": "main",
            "pattern": "/sub/new"
          },
          {
            "kind": "title",
            "frame": "main",
            "equals": "OPEN SUB-ACCOUNT"
          }
        ],
        "timeout_ms": 10000
      },
      "source": "model"
    },
    {
      "id": "s5",
      "intent": "Choose option in \"Share Type\"",
      "action": {
        "type": "select",
