        "timeout_ms": 10000
      },
      "source": "model"
    },
    {
      "id": "s9",
      "intent": "Activate button \"Confirm\"",
      "action": {
        "type": "click",
        "target": {
          "frame": "main",
          "role": "button",
          "name": "Confirm",
          "nth": 0,
          "fallbacks": [
            {
              "strategy": "css",
              "value": "input[type=\"submit\"][value=\"Confirm\"]"
            }
          ]
        }
      },
      "risk": "irreversible",
      "expect": {
        "all_of": [
          {
            "kind": "route",
            "frame": "main",
            "pattern": "/sub/confirm"
          },
          {
            "kind": "title",
            "frame": "main",
            "equals": "SUB-ACCOUNT OPENED"
          }
