{
  "schema": "cua.capability/v1",
  "id": "coreteller.member.open_sub_account",
  "version": "1.0.0",
  "status": "approved",
  "title": "Open member sub-account",
  "description": "Opens a new share sub-account for an existing member and returns the host confirmation number.",
  "app": {
    "profile": "acme-coreteller",
    "profile_version": "4.2"
  },
  "surface": "web",
  "entry_route": "/",
  "requires_session": true,
  "inputs": {
    "member_id": {
      "type": "string",
      "description": "member id (digits)",
      "required": true,
      "pattern": "^\\d{1,12}$",
      "sensitivity": "pii"
    },
    "share_type": {
      "type": "enum",
      "description": "share type (one of the host's options)",
      "required": true,
      "enum": [
        "SAVINGS",
        "HOLIDAY CLUB",
        "VACATION CLUB",
        "MONEY MARKET"
      ],
      "sensitivity": "internal"
    },
    "nickname": {
      "type": "string",
      "description": "nickname",
      "required": true,
      "sensitivity": "pii"
    },
    "initial_deposit": {
      "type": "decimal",
      "description": "initial deposit",
      "required": true,
      "sensitivity": "internal"
    }
  },
  "outputs": {
    "confirmation_number": {
      "type": "string",
      "description": "Host confirmation number",
      "sensitivity": "internal"
    },
    "suffix": {
      "type": "string",
      "description": "Suffix of the new sub-account",
      "sensitivity": "internal"
    }
  },
  "outcomes": [
    {
      "code": "member_not_found",
      "description": "No member exists with the supplied member number."
    },
    {
      "code": "access_restricted",
      "description": "The member record is restricted for this operator (permission denial)."
    },
    {
      "code": "invalid_input",
      "description": "The host rejected an input value (validation error ERR nnnn)."
    }
  ],
  "steps": [
    {
      "id": "s1",
      "intent": "Activate link \"Member Inquiry\"",
      "action": {
        "type": "click",
        "target": {
          "frame": "nav",
          "role": "link",
          "name": "Member Inquiry",
          "nth": 0,
          "fallbacks": []
        }
      },
      "risk": "read",
      "expect": {
        "all_of": [
          {
            "kind": "route",
            "frame": "main",
            "pattern": "/inq"
          },
          {
            "kind": "title",
            "frame": "main",
            "equals": "MEMBER INQUIRY"
          }
        ],
        "timeout_ms": 10000
      },
      "source": "model"
    },
    {
      "id": "s2",
      "intent": "Enter {member_id} into \"Member Number\"",
      "action": {
        "type": "fill",
        "target": {
          "frame": "main",
          "role": "textbox",
          "name": "Member Number",
          "nth": 0,
          "fallbacks": [
            {
              "strategy": "css",
              "value": "input[name=\"q\"]"
            }
          ]
        },
        "value": {
          "kind": "param",
          "name": "member_id"
        }
      },
      "risk": "read",
      "source": "model"
    },
    {
      "id": "s3",
      "intent": "Activate button \"Search\"",
      "action": {
        "type": "click",
        "target": {
          "frame": "main",
          "role": "button",
          "name": "Search",
          "nth": 0,
          "fallbacks": [
            {
              "strategy": "css",
              "value": "input[type=\"button\"][value=\"Search\"]"
            }
          ]
        }
      },
      "risk": "read",
      "expect": {
        "all_of": [
          {
            "kind": "route",
            "frame": "main",
            "pattern": "/mbr/{member_id}"
          },
          {
            "kind": "title",
            "frame": "main",
            "equals": "MEMBER SUMMARY"
          }
        ],
        "timeout_ms": 10000
      },
      "source": "model"
    },
    {
      "id": "s4",
      "intent": "Activate link \"Open Sub-Account\"",
      "action": {
        "type": "click",
        "target": {
          "frame": "main",
          "role": "link",
          "name": "Open Sub-Account",
          "nth": 0,
          "fallbacks": []
        }
      },
      "risk": "read",
