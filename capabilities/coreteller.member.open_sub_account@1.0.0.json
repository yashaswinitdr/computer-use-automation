          "name": "Nickname",
          "nth": 0,
          "fallbacks": [
            {
              "strategy": "css",
              "value": "input[name=\"x2\"]"
            }
          ]
        },
        "value": {
          "kind": "param",
          "name": "nickname"
        }
      },
      "risk": "read",
      "source": "model"
    },
    {
      "id": "s7",
      "intent": "Enter {initial_deposit} into \"Initial Deposit\"",
      "action": {
        "type": "fill",
        "target": {
          "frame": "main",
          "role": "textbox",
          "name": "Initial Deposit",
          "nth": 0,
          "fallbacks": [
            {
              "strategy": "css",
              "value": "input[name=\"x9\"]"
            }
          ]
        },
        "value": {
          "kind": "param",
          "name": "initial_deposit"
        }
      },
      "risk": "read",
      "source": "model"
    },
    {
      "id": "s8",
      "intent": "Activate button \"Continue\"",
      "action": {
        "type": "click",
        "target": {
          "frame": "main",
          "role": "button",
          "name": "Continue",
          "nth": 0,
          "fallbacks": [
            {
              "strategy": "css",
              "value": "input[type=\"submit\"][value=\"Continue\"]"
            }
          ]
        }
      },
      "risk": "write",
      "expect": {
        "all_of": [
          {
            "kind": "route",
            "frame": "main",
            "pattern": "/sub/review"
          },
          {
            "kind": "title",
            "frame": "main",
            "equals": "REVIEW SUB-ACCOUNT"
          }
