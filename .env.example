# Discovery uses a LOCAL model through Ollama by default: no API key needed.
#   ollama pull qwen2.5:7b
# OLLAMA_HOST=http://127.0.0.1:11434
# CUA_MODEL=qwen2.5:7b
#
# Optional, only if you choose a hosted provider (--provider anthropic|openai):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Test-only credentials for the local synthetic target app (see target_app/seed.py). Not real secrets.
FCCU_TELLER_USER=TELLER01
FCCU_TELLER_PASSWORD=teller01-local-test
RVFCU_TELLER_USER=TELLER01
RVFCU_TELLER_PASSWORD=teller01-local-test
